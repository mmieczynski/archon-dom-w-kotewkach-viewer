# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# uv
uv.lock.bak

# OS
.DS_Store

# Build artifacts - generated, never hand-edited (see README.md).
# tests/golden/ is NOT under build/, so it is committed on purpose
# (T13 golden overlay images) and is unaffected by this rule.
build/*
!build/.gitkeep

# Artifacts the GitHub Pages site serves. Still generated, still never hand-edited --
# `just build && just report` reproduces them byte-identically -- but Pages has no build
# step, so the viewer needs them committed. Regenerate and commit after any spec change.
!build/model.glb
!build/quantities.json
!build/overlay_ground.png
!build/overlay_attic.png
!build/overlay_ground_mirrored.png
!build/overlay_attic_mirrored.png
!build/REPORT.md
